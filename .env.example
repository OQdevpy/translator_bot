BOT_TOKEN=your_telegram_bot_token
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_MODEL=eleven_v3
# akkauntingizdagi ovoz ID si (bepul tarifda faqat premade ovozlar ishlaydi)
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# /usage va har kungi hisobot (Telegram user ID lar, vergul bilan)
ADMIN_IDS=123456789
TIMEZONE=Asia/Tashkent
REPORT_TIME=21:00
# Gemini narxi, 1M token uchun USD (chiqishga thinking ham kiradi)
GEMINI_PRICE_IN=1.50
GEMINI_PRICE_AUDIO_IN=1.50
GEMINI_PRICE_OUT=7.50
# ixtiyoriy: oylik limit, /usage da qolgan summani ko'rsatadi
GEMINI_MONTHLY_BUDGET_USD=

# Web sayt (python web.py yoki docker compose dagi stt_web)
HOST=0.0.0.0
PORT=8000
# saytga kirish paroli (bo'sh qolsa, sayt hamma uchun ochiq va API kalitlaringiz sarflanadi)
WEB_PASSWORD=
# Mikrofon faqat HTTPS da ishlaydi: domen/sertifikat bo'lmasa 1 qiling (brauzer bir marta ogohlantiradi)
SSL_SELF_SIGNED=1
# yoki o'z sertifikatingiz:
SSL_CERTFILE=
SSL_KEYFILE=

# Seminar rejimi
# spikerlarni ovozidan ajratish (ovoz izi modeli); 0 = faqat Gemini
VOICEPRINTS=1
# hisobot uchun boshqa (kuchliroq) model, bo'sh = GEMINI_MODEL
GEMINI_REPORT_MODEL=
